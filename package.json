{
  "name": "hl-dsc",
  "version": "1.0.0",
  "description": "hl-dsc — 轻量手机 AI 聊天客户端，支持自定义 OpenAI 兼容 API、文档与图片理解、语音与视频通话。",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sizhenhualei/hl-dsc.git"
  },
  "homepage": "https://github.com/sizhenhualei/hl-dsc",
  "bugs": {
    "url": "https://github.com/sizhenhualei/hl-dsc/issues"
  },
  "keywords": [
    "ai-chat",
    "deepseek",
    "openai-compatible",
    "capacitor",
    "android",
    "mobile"
  ],
  "author": "sizhenhualei",
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "preview": "node server.mjs",
    "build": "node scripts/build.mjs",
    "android:icons": "node scripts/make-android-icons.mjs",
    "android:sync": "npm run build && npx cap sync android && node scripts/make-android-icons.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/core": "6.2.1",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "cfb": "^1.2.2",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mammoth": "^1.13.0",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "pdfjs-dist": "^6.5.438",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2"
  }
}
